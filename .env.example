# Copiază în .env și completează local. .env nu se comite (vezi .gitignore).

# Rol de execuție al aplicației — privilegii restrânse (fără UPDATE/DELETE pe source_object).
DATABASE_URL=postgresql+psycopg://aiefactura_app:aiefactura_app_dev@localhost:5433/aiefactura

# Rol proprietar al schemei — DOAR pentru rularea migrărilor Alembic, niciodată pentru runtime.
DATABASE_URL_MIGRATIONS=postgresql+psycopg://aiefactura:aiefactura_dev@localhost:5433/aiefactura

# Folosit pentru semnarea sesiunilor de autentificare. Generează una unica per instalare:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=schimba-aceasta-cheie-in-productie

# Directoare monitorizate automat pentru scanare (separate prin ;), lăsat gol = dezactivat
WATCH_DIRECTORIES=

# Directorul de sub care se permite scanarea manuală / drag-and-drop pe server
SCAN_ROOT=./data/scan

# CIF-urile companiei/companiilor proprii (separate prin ;) -- determina daca o
# factura e "iesire" (emitent = CIF propriu) sau "intrare" (implicit)
OWN_CIFS=

ENVIRONMENT=development
